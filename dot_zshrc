# >>> wt init >>>
wt() {
  local cdfile; cdfile=$(mktemp -t wt.cd)
  WT_CD_FILE=$cdfile command wt "$@"
  local rc=$?
  [[ -s $cdfile ]] && cd "$(cat "$cdfile")"
  rm -f "$cdfile"
  return $rc
}
